{
  "name": "dsh-lingualab",
  "version": "0.21.6",
  "description": "LinguaLab — a study panel that turns workspace media (audio plus subtitles) into intensive-listening practice.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "language-learning",
    "listening-practice",
    "subtitles",
    "shadowing",
    "audio",
    "video",
    "review"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs/*.md",
    "locale/*.json"
  ],
  "scripts": {
    "betterer": "betterer",
    "betterer:ci": "betterer ci",
    "bilingual:check": "node scripts/check-bilingual.mjs",
    "build": "tsdown",
    "build:check": "node scripts/check-build.mjs",
    "changelog:check": "node scripts/check-changelog.mjs",
    "deploy": "node scripts/deploy.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "links:check": "node scripts/check-links.mjs",
    "lint": "eslint .",
    "lint:fsd": "steiger src/client && steiger src/host",
    "notes:check": "node scripts/check-notes.mjs",
    "notes:links": "node scripts/check-note-links.mjs",
    "prepare": "node -e \"try { require.resolve('husky') } catch { process.exit(0) } require('node:child_process').execSync('husky', { stdio: 'inherit' })\"",
    "release": "node scripts/release.mjs",
    "release:check": "node scripts/check-version-bump.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "screenshots:check": "node scripts/check-screenshots.mjs",
    "screenshots:test": "node scripts/check-screenshots.mjs --self-test",
    "ship": "node scripts/ship.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "skills:sync": "node scripts/sync-skills.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify": "node scripts/verify.mjs",
    "watch": "tsdown --watch",
    "zh:prose": "node scripts/check-zh-prose.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@betterer/betterer": "^6.0.0-alpha.1",
    "@betterer/cli": "^6.0.0-alpha.1",
    "@betterer/eslint": "^6.0.0-alpha.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.6.0",
    "@types/node": "^26.6.4",
    "@types/react": "~18.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.2.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "steiger": "^0.5.11",
    "tsdown": "^0.22.14",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.5",
    "zod-validation-error": "^4.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TecFancy/dsh-lingualab.git"
  },
  "homepage": "https://github.com/TecFancy/dsh-lingualab",
  "bugs": {
    "url": "https://github.com/TecFancy/dsh-lingualab/issues"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-sidebar": ">=0.2.2-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.2 <0.3.0"
  }
}
